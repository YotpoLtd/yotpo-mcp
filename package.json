{
  "name": "@yotpo/mcp-server",
  "version": "0.1.0",
  "description": "Yotpo MCP Server - Model Context Protocol server for Yotpo's API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yotpo-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "yotpo",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.17",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.27.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.1.3"
  }
}
